# Synthetic Isolated Test Environment Profile (Zero Real Credentials)
APP_ENV=test
ENV=test
ENVIRONMENT=test
BOONTRACK_ENV=test
TEST_STRICT_DB_GUARD=1
TEST_REQUIRE_DISPOSABLE_SERVICES=1
ENABLE_LOCAL_REDIS=true

# Disposable PostgreSQL & Redis (host loopback ports matching docker-compose.test.yml)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=test_boontrack
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password
DATABASE_URL=postgresql://test_user:test_password@127.0.0.1:55432/test_boontrack

# Isolated per-suite disposable PostgreSQL DSNs (zero cross-suite collision)
STAGE1_TEST_DISPOSABLE_PG_DSN=postgresql://test_user:test_password@127.0.0.1:55432/bt_stage1_disposable_test_stage1
STAGE3_STEP0_DISPOSABLE_PG_DSN=postgresql://test_user:test_password@127.0.0.1:55432/bt_stage1_disposable_test_step0
STAGE3_STEP1_DISPOSABLE_PG_DSN=postgresql://test_user:test_password@127.0.0.1:55432/bt_stage1_disposable_test_step1

REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379/0

# Non-routable local Supabase stub (NEVER production URL, NEVER real keys)
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPECTED_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=test_ci_supabase_anon_key_mock_999
