import os
import json
import base64
import logging
import aiohttp
from typing import Optional, Dict, Any
from google import genai
from google.genai import types

logger = logging.getLogger(__name__)

GEMINI_API_KEY = os.getenv("GEMINI_API_KEY")
OPENROUTER_API_KEY = os.getenv("OPENROUTER_API_KEY")
GEMINI_MODEL_NAME = os.getenv("GEMINI_MODEL", "gemini-2.5-flash")

OCR_PROMPT = (
    "Kamu adalah AI OCR parser khusus bukti transfer bank & e-wallet Indonesia (BCA, Mandiri, BRI, BNI, DANA, GoPay, OVO, ShopeePay, LinkAja). "
    "Ekstrak data bukti pembayaran dari gambar ini dalam format JSON murni tanpa format markdown code block atau backticks:\n"
    "{\n"
    '  "is_transfer_receipt": true,\n'
    '  "amount": 25000,\n'
    '  "recipient": "nama penerima atau merchant",\n'
    '  "sender": "nama pengirim jika ada",\n'
    '  "status": "SUCCESS"\n'
    "}\n"
    "Ketentuan penting:\n"
    "1. Field 'amount' WAJIB berupa angka integer murni (tanpa Rp, titik, koma, atau spasi).\n"
    "2. Jika gambar bukan bukti pembayaran, set 'is_transfer_receipt' ke false."
)


def _clean_json_str(raw_text: str) -> str:
    raw_text = raw_text.strip()
    if raw_text.startswith("```json"):
        raw_text = raw_text[7:]
    if raw_text.startswith("```"):
        raw_text = raw_text[3:]
    if raw_text.endswith("```"):
        raw_text = raw_text[:-3]
    return raw_text.strip()


async def _ocr_gemini_primary(image_bytes: bytes) -> Optional[Dict[str, Any]]:
    """Membaca screenshot bukti transfer menggunakan Gemini Flash secara langsung."""
    if not GEMINI_API_KEY:
        logger.error("[OCR] GEMINI_API_KEY is not configured.")
        return None

    try:
        client = genai.Client(api_key=GEMINI_API_KEY)
        response = client.models.generate_content(
            model=GEMINI_MODEL_NAME,
            contents=[
                types.Part.from_bytes(data=image_bytes, mime_type="image/jpeg"),
                OCR_PROMPT
            ]
        )
        parsed = json.loads(_clean_json_str(response.text))
        logger.info(f"[OCR SUCCESS - GEMINI {GEMINI_MODEL_NAME}] {parsed}")
        return parsed
    except Exception as e:
        logger.warning(f"[OCR Gemini Failed] {e}")
        return None


async def _ocr_openrouter_fallback(image_bytes: bytes) -> Optional[Dict[str, Any]]:
    """Cadangan Vision via OpenRouter menggunakan model Llama 3.2 Vision jika Gemini kena limit."""
    if not OPENROUTER_API_KEY:
        logger.warning("[OCR Fallback] OPENROUTER_API_KEY not configured.")
        return None

    try:
        base64_image = base64.b64encode(image_bytes).decode("utf-8")
        headers = {
            "Authorization": f"Bearer {OPENROUTER_API_KEY}",
            "Content-Type": "application/json",
            "HTTP-Referer": "[https://boontrack.id](https://boontrack.id)",
            "X-Title": "BoonTrack Core"
        }
        payload = {
            "model": "meta-llama/llama-3.2-11b-vision-instruct",
            "messages": [
                {
                    "role": "user",
                    "content": [
                        {"type": "text", "text": OCR_PROMPT},
                        {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{base64_image}"}}
                    ]
                }
            ],
            "temperature": 0.1
        }
        async with aiohttp.ClientSession() as session:
            async with session.post("[https://openrouter.ai/api/v1/chat/completions](https://openrouter.ai/api/v1/chat/completions)", headers=headers, json=payload) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    content = data["choices"][0]["message"]["content"]
                    parsed = json.loads(_clean_json_str(content))
                    logger.info(f"[OCR SUCCESS - OPENROUTER LLAMA-3.2-VISION] {parsed}")
                    return parsed
                else:
                    err_text = await resp.text()
                    logger.error(f"[OCR OpenRouter Response Error] Status {resp.status}: {err_text}")
                    return None
    except Exception as e:
        logger.error(f"[OCR OpenRouter Exception] {e}")
        return None


async def parse_receipt_image(image_bytes: bytes) -> Optional[Dict[str, Any]]:
    """Fungsi utama untuk mengekstrak data struk transfer dengan fallback otomatis."""
    # 1. Coba Primary OCR (Gemini)
    res = await _ocr_gemini_primary(image_bytes)
    if res and res.get("is_transfer_receipt"):
        return res

    # 2. Coba Fallback OCR (OpenRouter) jika Gemini gagal
    res_fallback = await _ocr_openrouter_fallback(image_bytes)
    if res_fallback:
        return res_fallback

    return res